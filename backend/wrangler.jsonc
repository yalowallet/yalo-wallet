{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yalo-p2p-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-15",
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yalo-p2p",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PRIVY_ISSUER": "privy.io"
  }
}
